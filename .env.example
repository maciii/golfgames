# Adresa katalogu hřišť.
#
# Katalog je samostatný projekt (github.com/maciii/golfgames-courses) a tahle
# proměnná je jediné, co ho s aplikací spojuje. Bez ní se výběr hřiště obejde -
# hledá dál v hřištích uložených v zařízení a ruční zadání funguje vždycky -
# ale žádné hřiště se nenabídne ze serveru.
#
# V nasazení ji drží repository variable stejného jména.

VITE_COURSES_URL=https://maciii.github.io/golfgames-courses/

# Konfigurace Firebase pro synchronizaci.
#
# Zkopíruj do .env.local a doplň hodnoty z Firebase Console
# (Project settings -> Your apps -> Web app -> SDK setup and configuration).
#
# Tyhle údaje nejsou tajné - u Firebase jsou veřejné z principu a zabezpečení
# stojí na pravidlech v firestore.rules. Přesto se do repozitáře nedávají,
# aby šlo projekt přesměrovat na jiný Firebase projekt bez zásahu do kódu.
#
# Bez těchhle proměnných se aplikace postaví i spustí; jen se v ní neobjeví
# přihlášení a všechno zůstane v zařízení.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
